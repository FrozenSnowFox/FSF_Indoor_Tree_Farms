		<operations>

			<li Class="PatchOperationTest">
				<xpath>/Defs/ThingDef[defName = "CK_SpecialTreeHive"]</xpath>
			</li>

	<!-- Fix Tree Spacing -->

			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "CK_SpecialTreeHive"]/plant/blockAdjacentSow</xpath>
					<value>
						<blockAdjacentSow>false</blockAdjacentSow>
					</value>
			</li>
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "CK_PlantRafflesia"]/plant/blockAdjacentSow</xpath>
					<value>
						<blockAdjacentSow>false</blockAdjacentSow>
					</value>
			</li>
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "CK_PlantTreeWildCoconutPalm"]/plant/blockAdjacentSow</xpath>
					<value>
						<blockAdjacentSow>false</blockAdjacentSow>
					</value>
			</li>
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "CK_PlantTreeMahogany"]/plant/blockAdjacentSow</xpath>
					<value>
						<blockAdjacentSow>false</blockAdjacentSow>
					</value>
			</li>
			
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName = "CK_PlantTreeWildBanana"]/plant/blockAdjacentSow</xpath>
					<value>
						<blockAdjacentSow>false</blockAdjacentSow>
					</value>
			</li>

		</operations>
	</Operation>

</Patch>